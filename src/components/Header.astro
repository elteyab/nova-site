---
import type { Dictionary, Locale } from '../i18n/config';
import { LOCALES, localePath } from '../i18n/config';

interface Props {
  locale: Locale;
  t: Dictionary['header'];
}

const { locale, t } = Astro.props;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(locale)} aria-label="Nova home">NOVA<sup>IDE</sup></a>
    <nav class="nav" aria-label="primary">
      <a href="#features">{t.features}</a>
      <a href="#download">{t.download}</a>
    </nav>
    <div class="controls">
      <div class="themes" role="group" aria-label={t.themeLabel}>
        <button type="button" data-theme-btn="mono" aria-pressed="true">MONO</button>
        <button type="button" data-theme-btn="nova-dark" aria-pressed="false">DARK</button>
        <button type="button" data-theme-btn="nova-light" aria-pressed="false">LIGHT</button>
      </div>
      <div class="langs" role="group" aria-label={t.langLabel}>
        {LOCALES.map((l) => (
          <a
            href={localePath(l.code)}
            hreflang={l.code}
            aria-current={l.code === locale ? 'page' : undefined}
            class:list={[{ active: l.code === locale }]}
          >
            {l.code.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    try {
      var root = document.documentElement;
      var btns = Array.prototype.slice.call(document.querySelectorAll('[data-theme-btn]'));
      function apply(t) {
        root.setAttribute('data-theme', t);
        try {
          localStorage.setItem('nova-theme', t);
        } catch (e) {}
        btns.forEach(function (b) {
          var on = b.getAttribute('data-theme-btn') === t;
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          b.classList.toggle('active', on);
        });
      }
      var saved = null;
      try {
        saved = localStorage.getItem('nova-theme');
      } catch (e) {}
      apply(saved === 'nova-dark' || saved === 'nova-light' ? saved : 'mono');
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          apply(b.getAttribute('data-theme-btn'));
        });
      });
    } catch (e) {}
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: var(--line-medium);
    background: var(--background);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    min-height: 72px;
    padding-block: 0.5rem;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .brand sup {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    border: var(--line-thin);
    padding: 0.1rem 0.35rem;
    margin-inline-start: 0.5rem;
    vertical-align: super;
  }
  .nav {
    display: none;
    gap: 2rem;
  }
  .nav a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover {
    border-bottom-color: var(--foreground);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .langs,
  .themes {
    display: flex;
    border: var(--line-thin);
  }
  .langs a,
  .themes button {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.6rem 0.8rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--foreground);
    background: transparent;
    border: none;
    border-inline-end: var(--line-thin);
    cursor: pointer;
  }
  .langs a:last-child,
  .themes button:last-child {
    border-inline-end: none;
  }
  .langs a:hover,
  .langs a.active,
  .themes button:hover,
  .themes button.active {
    background: var(--foreground);
    color: var(--background);
  }
  .themes button:focus-visible {
    outline: 3px solid var(--foreground);
    outline-offset: 3px;
  }
  @media (min-width: 720px) {
    .nav {
      display: flex;
    }
  }
</style>
