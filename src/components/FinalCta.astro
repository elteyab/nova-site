---
import type { Dictionary } from '../i18n/config';
import { PLAY_URL } from '../i18n/config';

interface Props {
  t: Dictionary['final'];
}

const { t } = Astro.props;
---

<section class="final inverted" aria-labelledby="final-title">
  <div class="veil texture-glow-inverted" aria-hidden="true"></div>
  <div class="container inner">
    <h2 class="display-7xl" id="final-title">{t.title}</h2>
    <p class="lead body">{t.body}</p>
    <a class="btn btn-inverted" href={PLAY_URL} rel="noopener">{t.cta}</a>
  </div>
</section>

<style>
  .final {
    background: var(--inverted-bg);
    color: var(--inverted-fg);
    border-top: var(--line-ultra);
    border-top-color: var(--inverted-bg);
    position: relative;
    overflow: hidden;
  }
  .veil {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    pointer-events: none;
  }
  .inner {
    position: relative;
    padding-block: 6rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  @media (min-width: 768px) {
    .inner {
      padding-block: 9rem;
    }
  }
  .body {
    color: var(--inverted-fg);
    margin: 1.5rem 0 2.5rem;
  }
</style>
